{
  "name": "loopcut",
  "private": true,
  "version": "0.0.1",
  "description": "LoopCut — a GIF maker with a video-editor workflow, hardware acceleration and high-quality exports.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "ffmpeg:verify": "node scripts/verify-ffmpeg.mjs",
    "bindings": "cargo test -p loopcut-core --features ts-export export_bindings",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-log": "2.10.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-updater": "2.13.2",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.3",
    "immer": "11.1.21",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "tailwind-merge": "3.7.0",
    "tinykeys": "4.0.1",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
