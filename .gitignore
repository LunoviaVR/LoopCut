/bindings/
/crates/*/bindings/
/src-tauri/bindings/

# Fetched FFmpeg binaries (see scripts/fetch-ffmpeg.mjs)
/src-tauri/resources/ffmpeg/
/.cache/

# Test artifacts
/test-results/
/playwright-report/
/.vitest/
/crates/*/tests/media/generated/
*.partial

# Signing keys must never be committed
*.key
!*.key.pub

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
